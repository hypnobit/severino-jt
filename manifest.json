{
  "manifest_version": 2,
  "name": "Severino JT",
  "version": "0.1.2",
  "description": "Extensão de Firefox para o PJe da Justiça do Trabalho (TRT): histórico de acessos, tema escuro, e-carta em lote, extrator de cálculo e triagem inicial.",
  "author": "hypnobit",
  "browser_specific_settings": {
    "gecko": {
      "id": "pje-tools@hypnobit",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://pje.trt8.jus.br/pjekz/assets/pdf/web/viewer.html*"],
      "js": ["lib/consentimento.js", "modules/dark-theme.js"],
      "all_frames": true,
      "run_at": "document_end"
    },
    {
      "matches": ["*://pje.trt8.jus.br/*"],
      "js": [
        "lib/helpers.js",
        "lib/csv.js",
        "lib/consentimento.js",
        "core/context.js",
        "modules/historico.js",
        "modules/dark-theme.js",
        "modules/ecarta-lote.js",
        "modules/atalho-triagem.js"
      ],
      "all_frames": false,
      "run_at": "document_end"
    }
  ],

  "background": {
    "scripts": ["lib/consentimento.js", "background/background.js"]
  },

  "browser_action": {
    "default_title": "Severino JT",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },

  "permissions": [
    "*://pje.trt8.jus.br/*",
    "storage",
    "webRequest",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "tabs"
  ]
}
